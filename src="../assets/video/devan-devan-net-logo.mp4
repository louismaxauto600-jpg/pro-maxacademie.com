<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DEVAN DEVAN NÈT™ | Le Mouvement de l’Ère IA</title>

<meta name="description" content="DEVAN DEVAN NÈT™ — Le Mouvement de l’Ère IA intégré à PRO-MAX ACADÉMIE, au sein de BSS1815 PRO-MAX DMP.">
<meta name="theme-color" content="#000000">

<style>
/* =========================================================
   DEVAN DEVAN NÈT™
   LE MOUVEMENT DE L'ÈRE IA
   ORANGE + BLACK ONLY
========================================================= */

:root{
  --black:#000000;
  --black-soft:#080300;
  --black-card:#0d0500;

  --orange:#ff7900;
  --orange-2:#ff8c1a;
  --orange-3:#ffad4d;
  --orange-dark:#9e4300;

  --border:rgba(255,121,0,.30);
  --border-strong:rgba(255,121,0,.65);

  --glow:0 0 18px rgba(255,121,0,.35);
  --glow-strong:
      0 0 15px rgba(255,121,0,.65),
      0 0 35px rgba(255,121,0,.35);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:
    radial-gradient(circle at 20% 20%,rgba(255,121,0,.15),transparent 35%),
    radial-gradient(circle at 80% 65%,rgba(255,121,0,.10),transparent 40%),
    linear-gradient(180deg,#000000 0%,#090400 48%,#000000 100%);
  color:var(--orange-3);
  overflow-x:hidden;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-1;
  background-image:
    linear-gradient(rgba(255,121,0,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,121,0,.035) 1px,transparent 1px);
  background-size:44px 44px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.8),transparent);
}

a{
  color:inherit;
  text-decoration:none;
}

button{
  font:inherit;
}

img,
video{
  max-width:100%;
}

.container{
  width:min(1220px,calc(100% - 28px));
  margin:auto;
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{
  padding:8px 14px;
  text-align:center;
  border-bottom:1px solid var(--border);
  background:#000;
  color:var(--orange-2);
  font-size:.72rem;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
}


/* =========================================================
   HEADER
========================================================= */

header{
  position:sticky;
  top:0;
  z-index:999;
  background:rgba(0,0,0,.96);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
}

.header-inner{
  min-height:78px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
}

.brand-mark{
  width:54px;
  height:54px;
  border-radius:50%;
  border:2px solid var(--orange);
  display:grid;
  place-items:center;
  background:#000;
  box-shadow:var(--glow);
  color:var(--orange);
  font-weight:1000;
  font-size:1rem;
}

.brand-text strong{
  display:block;
  color:var(--orange);
  font-size:.95rem;
  line-height:1;
  letter-spacing:.04em;
}

.brand-text span{
  display:block;
  color:var(--orange-3);
  font-size:.58rem;
  margin-top:5px;
  text-transform:uppercase;
  font-weight:900;
}

.desktop-nav{
  display:flex;
  align-items:center;
  gap:3px;
}

.nav-link{
  padding:10px 10px;
  border-radius:9px;
  color:var(--orange-3);
  font-size:.72rem;
  text-transform:uppercase;
  font-weight:950;
  transition:.25s ease;
}

.nav-link:hover{
  background:var(--orange);
  color:#000;
}

.lang-switch{
  display:flex;
  gap:3px;
  padding:3px;
  border:1px solid var(--border);
  border-radius:999px;
  background:#000;
}

.lang-btn{
  border:0;
  border-radius:999px;
  padding:8px 10px;
  background:#000;
  color:var(--orange-3);
  font-size:.66rem;
  font-weight:950;
  cursor:pointer;
}

.lang-btn.active{
  color:#000;
  background:var(--orange);
}

.menu-btn{
  display:none;
  width:45px;
  height:45px;
  border:1px solid var(--border);
  background:#000;
  color:var(--orange);
  border-radius:10px;
  cursor:pointer;
  font-size:1.2rem;
}


/* =========================================================
   MOBILE NAV
========================================================= */

.mobile-nav{
  display:none;
  border-top:1px solid var(--border);
  background:#000;
  padding:12px 14px 18px;
}

.mobile-nav.open{
  display:block;
}

.mobile-nav a{
  display:block;
  padding:13px;
  margin-bottom:5px;
  border:1px solid var(--border);
  border-radius:9px;
  color:var(--orange-3);
  text-transform:uppercase;
  font-size:.75rem;
  font-weight:900;
}


/* =========================================================
   HERO
========================================================= */

.hero{
  min-height:90vh;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:55px;
  padding:65px 0 80px;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:9px;
  border:1px solid var(--border-strong);
  background:rgba(255,121,0,.08);
  border-radius:999px;
  padding:9px 15px;
  color:var(--orange);
  font-size:.72rem;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.09em;
}

.hero-title{
  margin-top:20px;
  color:var(--orange);
  text-transform:uppercase;
  font-size:clamp(3.4rem,7vw,6.7rem);
  line-height:.83;
  font-weight:1000;
  letter-spacing:-.06em;
  text-shadow:0 0 35px rgba(255,121,0,.25);
}

.hero-title span{
  display:block;
  margin-top:15px;
  color:var(--orange-3);
  font-size:.27em;
  letter-spacing:.06em;
  line-height:1.05;
}

.hero-tagline{
  margin-top:23px;
  font-size:1.05rem;
  line-height:1.7;
  color:var(--orange-3);
  max-width:650px;
}

.hero-tagline strong{
  color:var(--orange);
}

.hero-quote{
  margin-top:22px;
  padding:16px 19px;
  border-left:4px solid var(--orange);
  background:linear-gradient(90deg,rgba(255,121,0,.13),transparent);
  color:var(--orange-2);
  font-size:1rem;
  font-weight:900;
  line-height:1.55;
}

.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-top:30px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  min-height:48px;
  padding:12px 20px;
  border-radius:999px;
  border:2px solid var(--orange);
  text-transform:uppercase;
  font-size:.74rem;
  font-weight:1000;
  letter-spacing:.05em;
  transition:.25s ease;
}

.btn-primary{
  background:var(--orange);
  color:#000;
  box-shadow:var(--glow);
}

.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:var(--glow-strong);
}

.btn-secondary{
  background:#000;
  color:var(--orange);
}

.btn-secondary:hover{
  background:rgba(255,121,0,.10);
}


/* =========================================================
   HERO VIDEO
========================================================= */

.hero-media{
  position:relative;
  display:flex;
  justify-content:center;
  align-items:center;
}

.video-orbit{
  position:relative;
  width:min(100%,560px);
  aspect-ratio:1/1;
  display:grid;
  place-items:center;
}

.video-orbit::before,
.video-orbit::after{
  content:"";
  position:absolute;
  border-radius:50%;
  border:1px solid var(--border);
  animation:orbitSpin 12s linear infinite;
}

.video-orbit::before{
  inset:2%;
  border-top:3px solid var(--orange);
  border-right-color:transparent;
}

.video-orbit::after{
  inset:9%;
  animation-direction:reverse;
  animation-duration:8s;
  border-bottom:2px solid var(--orange-2);
  border-left-color:transparent;
}

.logo-video{
  position:relative;
  z-index:2;
  width:82%;
  aspect-ratio:1/1;
  object-fit:cover;
  border-radius:50%;
  border:2px solid var(--orange);
  background:#000;
  box-shadow:
    0 0 25px rgba(255,121,0,.35),
    0 0 70px rgba(255,121,0,.18);
}

.orbit-dot{
  position:absolute;
  width:10px;
  height:10px;
  border-radius:50%;
  background:var(--orange);
  box-shadow:0 0 14px var(--orange);
  z-index:5;
}

.dot-1{
  top:8%;
  right:19%;
  animation:pulse 1.6s infinite;
}

.dot-2{
  bottom:13%;
  left:10%;
  animation:pulse 2.2s infinite;
}


/* =========================================================
   SECTION GENERAL
========================================================= */

section{
  scroll-margin-top:100px;
}

.section{
  padding:90px 0;
  border-top:1px solid rgba(255,121,0,.10);
}

.section-head{
  max-width:850px;
  margin-bottom:40px;
}

.eyebrow{
  color:var(--orange);
  text-transform:uppercase;
  font-size:.7rem;
  font-weight:1000;
  letter-spacing:.15em;
}

.section-title{
  margin-top:10px;
  color:var(--orange);
  font-size:clamp(2rem,5vw,4rem);
  text-transform:uppercase;
  line-height:.95;
  font-weight:1000;
}

.section-desc{
  margin-top:16px;
  color:var(--orange-3);
  line-height:1.75;
  font-size:1rem;
}


/* =========================================================
   FIVE PILLARS
========================================================= */

.pillars-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14px;
}

.pillar-card{
  position:relative;
  overflow:hidden;
  min-height:235px;
  padding:24px 18px;
  border:1px solid var(--border);
  border-radius:18px;
  background:
    radial-gradient(circle at top,rgba(255,121,0,.14),transparent 47%),
    #050200;
  transition:.3s ease;
}

.pillar-card::after{
  content:"";
  position:absolute;
  inset:auto 0 0 0;
  height:3px;
  background:var(--orange);
  transform:scaleX(0);
  transition:.3s ease;
  transform-origin:left;
}

.pillar-card:hover{
  transform:translateY(-7px);
  border-color:var(--orange);
  box-shadow:var(--glow);
}

.pillar-card:hover::after{
  transform:scaleX(1);
}

.pillar-number{
  font-size:2.5rem;
  font-weight:1000;
  color:var(--orange-dark);
}

.pillar-icon{
  margin-top:16px;
  font-size:2rem;
  filter:grayscale(1) sepia(1) saturate(8);
}

.pillar-card h3{
  margin-top:16px;
  color:var(--orange);
  font-size:.92rem;
  text-transform:uppercase;
}

.pillar-card p{
  margin-top:10px;
  color:var(--orange-3);
  font-size:.86rem;
  line-height:1.55;
}


/* =========================================================
   MANIFESTO
========================================================= */

.manifesto-layout{
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:35px;
  align-items:start;
}

.manifesto-statement{
  position:sticky;
  top:120px;
  border:1px solid var(--border-strong);
  border-radius:20px;
  padding:30px;
  background:
    linear-gradient(145deg,rgba(255,121,0,.14),rgba(0,0,0,.95));
  box-shadow:var(--glow);
}

.manifesto-statement strong{
  display:block;
  color:var(--orange);
  font-size:clamp(1.8rem,4vw,3.3rem);
  line-height:.95;
  text-transform:uppercase;
}

.manifesto-statement p{
  margin-top:20px;
  color:var(--orange-3);
  line-height:1.7;
}

.manifesto-content{
  display:grid;
  gap:14px;
}

.manifesto-item{
  padding:22px;
  border:1px solid var(--border);
  border-radius:15px;
  background:rgba(0,0,0,.65);
}

.manifesto-item h3{
  color:var(--orange);
  text-transform:uppercase;
  font-size:.95rem;
}

.manifesto-item p{
  margin-top:9px;
  color:var(--orange-3);
  line-height:1.7;
  font-size:.94rem;
}


/* =========================================================
   AI SECTION
========================================================= */

.ai-panel{
  position:relative;
  overflow:hidden;
  border:1px solid var(--border-strong);
  border-radius:25px;
  padding:45px;
  background:
    radial-gradient(circle at 80% 30%,rgba(255,121,0,.17),transparent 28%),
    linear-gradient(135deg,#000,rgba(255,121,0,.07),#000);
}

.ai-panel::before{
  content:"AI";
  position:absolute;
  right:5%;
  top:50%;
  transform:translateY(-50%);
  font-size:clamp(8rem,22vw,18rem);
  font-weight:1000;
  color:rgba(255,121,0,.035);
  pointer-events:none;
}

.ai-content{
  position:relative;
  z-index:2;
  max-width:770px;
}

.ai-content h2{
  color:var(--orange);
  font-size:clamp(2rem,5vw,4rem);
  text-transform:uppercase;
  line-height:.95;
}

.ai-content p{
  color:var(--orange-3);
  margin-top:18px;
  line-height:1.75;
}

.ai-list{
  margin-top:28px;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.ai-point{
  border:1px solid var(--border);
  border-radius:12px;
  padding:15px;
  color:var(--orange-2);
  background:#000;
  font-size:.86rem;
  font-weight:900;
}


/* =========================================================
   FORMATION
========================================================= */

.course-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.course-card{
  border:1px solid var(--border);
  border-radius:18px;
  padding:26px;
  background:linear-gradient(145deg,#000,#0c0500);
  transition:.3s ease;
}

.course-card:hover{
  border-color:var(--orange);
  transform:translateY(-5px);
  box-shadow:var(--glow);
}

.course-badge{
  display:inline-block;
  padding:6px 10px;
  border:1px solid var(--orange-dark);
  border-radius:999px;
  color:var(--orange);
  font-size:.65rem;
  font-weight:1000;
}

.course-card h3{
  color:var(--orange);
  margin-top:18px;
  text-transform:uppercase;
  font-size:1.13rem;
}

.course-card p{
  margin-top:12px;
  color:var(--orange-3);
  font-size:.9rem;
  line-height:1.65;
}

.course-link{
  margin-top:20px;
  display:inline-flex;
  color:var(--orange);
  text-transform:uppercase;
  font-size:.72rem;
  font-weight:1000;
}


/* =========================================================
   COMMUNITY
========================================================= */

.community{
  text-align:center;
}

.hashtag{
  display:inline-block;
  margin-top:25px;
  color:var(--orange);
  font-size:clamp(2rem,7vw,5rem);
  font-weight:1000;
  letter-spacing:-.05em;
  text-shadow:0 0 25px rgba(255,121,0,.35);
}

.community-actions{
  margin-top:28px;
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
}


/* =========================================================
   MEDIA
========================================================= */

.media-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.media-card{
  min-height:210px;
  border:1px solid var(--border);
  border-radius:18px;
  padding:23px;
  background:
    linear-gradient(180deg,rgba(255,121,0,.09),transparent),
    #000;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  transition:.25s ease;
}

.media-card:hover{
  transform:translateY(-5px);
  border-color:var(--orange);
  box-shadow:var(--glow);
}

.media-icon{
  margin-bottom:auto;
  font-size:2rem;
}

.media-card h3{
  color:var(--orange);
  text-transform:uppercase;
}

.media-card p{
  margin-top:9px;
  color:var(--orange-3);
  line-height:1.5;
  font-size:.85rem;
}


/* =========================================================
   PRO-MAX CONNECTION
========================================================= */

.connection{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:0;
  border:1px solid var(--border-strong);
  border-radius:22px;
  overflow:hidden;
}

.connection-box{
  min-height:190px;
  padding:28px 20px;
  background:#000;
  border-right:1px solid var(--border);
  display:flex;
  flex-direction:column;
  justify-content:center;
  text-align:center;
}

.connection-box:last-child{
  border-right:0;
}

.connection-box strong{
  color:var(--orange);
  text-transform:uppercase;
  font-size:1rem;
}

.connection-box span{
  margin-top:8px;
  color:var(--orange-3);
  font-size:.82rem;
  line-height:1.5;
}


/* =========================================================
   FINAL CTA
========================================================= */

.final-cta{
  padding:90px 0 100px;
  text-align:center;
}

.final-cta-box{
  position:relative;
  overflow:hidden;
  padding:60px 25px;
  border:1px solid var(--orange);
  border-radius:30px;
  background:
    radial-gradient(circle at center,rgba(255,121,0,.16),transparent 45%),
    #000;
  box-shadow:var(--glow);
}

.final-cta h2{
  color:var(--orange);
  font-size:clamp(2.8rem,8vw,6rem);
  line-height:.85;
  text-transform:uppercase;
  font-weight:1000;
}

.final-cta h2 span{
  display:block;
  margin-top:16px;
  color:var(--orange-3);
  font-size:.28em;
  letter-spacing:.08em;
}

.final-cta p{
  margin:25px auto 0;
  max-width:720px;
  color:var(--orange-3);
  line-height:1.75;
}

.final-buttons{
  margin-top:30px;
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
}


/* =========================================================
   FOOTER
========================================================= */

footer{
  border-top:1px solid var(--border);
  background:#000;
  padding:40px 0;
}

.footer-inner{
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:25px;
}

.footer-brand{
  color:var(--orange);
  font-weight:1000;
}

.footer-brand small{
  display:block;
  color:var(--orange-3);
  margin-top:7px;
  line-height:1.5;
}

.footer-right{
  text-align:right;
  color:var(--orange-2);
  font-size:.75rem;
  line-height:1.6;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes orbitSpin{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}

@keyframes pulse{
  0%,100%{
    transform:scale(.75);
    opacity:.45;
  }
  50%{
    transform:scale(1.4);
    opacity:1;
  }
}

.reveal{
  opacity:0;
  transform:translateY(28px);
  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.visible{
  opacity:1;
  transform:none;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1050px){

  .desktop-nav{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  .hero{
    grid-template-columns:1fr;
    text-align:center;
    padding-top:55px;
  }

  .hero-tagline{
    margin-left:auto;
    margin-right:auto;
  }

  .hero-actions{
    justify-content:center;
  }

  .hero-quote{
    max-width:720px;
    margin-left:auto;
    margin-right:auto;
    border-left:1px solid var(--orange);
  }

  .hero-media{
    margin-top:15px;
  }

  .pillars-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .manifesto-layout{
    grid-template-columns:1fr;
  }

  .manifesto-statement{
    position:relative;
    top:auto;
  }

  .course-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .media-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .connection{
    grid-template-columns:repeat(2,1fr);
  }

  .connection-box{
    border-bottom:1px solid var(--border);
  }
}


@media(max-width:650px){

  .header-inner{
    min-height:70px;
  }

  .brand-mark{
    width:45px;
    height:45px;
  }

  .brand-text strong{
    font-size:.82rem;
  }

  .brand-text span{
    font-size:.52rem;
  }

  .hero{
    min-height:auto;
    padding:50px 0 70px;
  }

  .hero-title{
    font-size:clamp(3.1rem,18vw,5rem);
  }

  .video-orbit{
    width:100%;
  }

  .section{
    padding:70px 0;
  }

  .pillars-grid,
  .course-grid,
  .media-grid,
  .connection,
  .ai-list{
    grid-template-columns:1fr;
  }

  .connection-box{
    border-right:0;
  }

  .ai-panel{
    padding:30px 22px;
  }

  .footer-inner{
    grid-template-columns:1fr;
    text-align:center;
  }

  .footer-right{
    text-align:center;
  }

  .lang-switch{
    display:none;
  }

  .hashtag{
